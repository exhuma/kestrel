# Import contracts for the backend (enforced by import-linter / `lint-imports`).
# Encodes the constitution's Principle II: "routers -> services -> stores, with
# calls flowing downward only." A layers contract also forbids import cycles
# between the layers. Do not weaken these to make an import pass — restructure
# the code (see AGENTS.md "Code-quality guardrails").

[importlinter]
root_package = app

# Constitution Principle II: "routers -> services -> stores, downward only."
# storage and persistence are coupled peers (persistence reaches storage's bus
# via the app.notifications leaf), so they are one "stores" tier rather than an
# ordered pair — modelled as the layer chain below plus the forbidden contract.
[importlinter:contract:layering]
name = Backend layering (routers -> services -> persistence, downward only)
type = layers
layers =
    app.routers
    app.services
    app.persistence

[importlinter:contract:stores-are-the-floor]
name = Stores (storage, persistence) never import the services or routers above
type = forbidden
source_modules =
    app.storage
    app.persistence
forbidden_modules =
    app.routers
    app.services

# The registry (app.backends.registry) is the composition root that wires every
# concrete adapter; it is imported widely and transitively. What we forbid is
# any layer reaching *directly* into a concrete adapter module and bypassing the
# Backend protocol seam. allow_indirect_imports keeps the check to direct edges.
[importlinter:contract:backend-adapters]
name = No direct imports of concrete backend adapters (wire them via the registry)
type = forbidden
allow_indirect_imports = True
source_modules =
    app.routers
    app.storage
    app.persistence
forbidden_modules =
    app.backends.claude_cli
    app.backends.opencode
    app.backends.openai_compat

# Constitution Principle VI: documents are modelled, never strings. Parsing and
# rendering a platform format happen only in the adapter at a system boundary.
# Every allowed edge is listed by name below — a new one is a design decision
# (which boundary is this?), never a way to make an import pass.
[importlinter:contract:documents-at-the-boundary]
name = Only boundary adapters parse or render documents (Principle VI)
type = forbidden
allow_indirect_imports = True
source_modules =
    app.services
    app.routers
    app.persistence
    app.storage
    app.models_board
    app.models_board_records
    app.backends
forbidden_modules =
    app.document_formats
ignore_imports =
    # Task sources and code hosts.
    app.services.github -> app.document_formats.markdown
    app.services.github_reviews -> app.document_formats.markdown
    app.services.github_tasksource -> app.document_formats.markdown
    app.services.gitlab -> app.document_formats.markdown
    app.services.jira -> app.document_formats.adf
    app.services.jira -> app.document_formats.markdown
    app.services.jira_client -> app.document_formats.adf
    app.services.jira_client -> app.document_formats.markdown
    app.services.local_task_source -> app.document_formats.markdown
    # Agents: prompts out, results in; and input screening.
    app.services.board.agent_text -> app.document_formats.markdown
    app.services.board.quarantine -> app.document_formats.markdown
    # Persistence.
    app.persistence.document_column -> app.document_formats.document_json
    app.persistence.document_column -> app.document_formats.markdown
    # The HTTP API.
    app.routers.document_out -> app.document_formats.markdown
