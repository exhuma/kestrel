{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-GB",
  "files": [
    "README.md",
    "docs/*.md",
    "backend/app/**/*.py",
    "frontend/src/**/*.{ts,vue}"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.venv/**"
  ],
  "words": [
    "aclose", "aread", "ASGI", "changeme", "codegen", "codehost", "conftest",
    "contextvar", "coro", "creds", "customfield", "dedup", "dedups",
    "deeplink", "deepseek", "demux", "diffstat", "DIFFSTAT",
    "dispatchable", "Dockerisation",
    "dotenv", "ecard", "ensembling", "exhuma", "extraheader", "fastapi",
    "Forgejo", "formedness", "gatelessly", "ghlink", "gitea", "glanceable",
    "gpgsign",
    "grayscale", "hostable", "iconsets", "idempotently",
    "HEALTHCHECK", "healthchecks", "healthz", "HMAC", "hrefs", "httpx",
    "infosec", "inspectable", "Instrumentor", "kestrelbot", "KEEPALIVE",
    "keepalives",
    "kwargs", "livez",
    "multiedit",
    "nosniff", "notebookedit", "notif", "notkestrel", "ntfy", "Okabe",
    "ollama", "oncall",
    "opencode", "pinentry", "Planka", "PROCS", "pydantic", "pyproject",
    "pytest", "qbadge", "qblock", "qform", "qgroup", "qtab", "qtabs",
    "reactable", "readyz",
    "Refetches", "reldir",
    "renamespaced", "reraise", "REPOLL", "REPOLLABLE", "rerunnable", "rgba",
    "runbook", "runbooks",
    "savestatus",
    "scard",
    "sessionmaker", "sqlalchemy", "stageroot", "substep", "taskfile",
    "tasksource", "timeparse", "timespent", "todowrite", "topbar",
    "traceparent", "Transitioner",
    "uiux", "unconfigured", "unqualifying",
    "parseable", "unloadable", "unparseable", "unretrieved",
    "unlabeled", "uvicorn", "viewnav", "Vite", "Vuetify", "webfetch",
    "webhook", "worktree", "worktrees", "Zammad"
  ]
}
