{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-GB",
  "files": [
    "README.md",
    "docs/*.md",
    "backend/app/**/*.py",
    "frontend/src/**/*.{ts,vue}"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.venv/**"
  ],
  "words": [
    "aclose", "ASGI", "askable", "CAINFO", "changeme", "chokepoint", "codegen",
    "codehost", "conftest", "contextvar", "coro", "creds", "customfield",
    "dedup", "deepseek", "Deserialise", "dispatchable", "dotenv", "exhuma",
    "extraheader", "fastapi", "Forgejo", "ghlink", "gitdir", "gitea",
    "hardbreak", "headlessly", "HEALTHCHECK", "healthchecks", "healthz", "HMAC",
    "hostable", "hrefs", "httpx", "iconsets", "idempotently", "importlinter",
    "infosec", "Instrumentor", "KEEPALIVE", "keepalives", "kubelet", "kwargs",
    "libpq", "livez", "malbert", "noopener", "noreferrer", "nosniff", "Okabe",
    "opencode", "prereqs", "psycopg", "pyaltiplano", "pydantic", "pyproject",
    "pytest", "pytestmark", "readyz", "reraise", "rerunnable", "retryable",
    "rgba", "runbook", "sessionmaker", "softbreak", "sqlalchemy", "sslmode",
    "stageroot", "taskfile", "tasksource", "timespent", "todowrite",
    "traceparent", "Transitioner", "uiux", "unconfigured", "unconvergeable",
    "UNDERSTING", "unestimated", "unloadable", "unparseable", "unposted",
    "unpushed", "unretrieved", "urlopen", "uvicorn", "Vite", "Vuetify",
    "webhook", "worktree", "worktrees"
  ]
}
